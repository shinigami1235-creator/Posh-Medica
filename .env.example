# Posh Medica website. Copy to .env and fill in. Never commit .env.
APP_NAME="Posh Medica"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.poshmedica.co.th
APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Bangkok

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=poshmedica
DB_USERNAME=poshmedica
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Outgoing email for contact form alerts and admin password resets
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@poshmedica.co.th
MAIL_FROM_NAME="Posh Medica website"

# Site
SITE_NOINDEX=false            # true on staging so Google doesn't index it
SITE_HSTS=0                   # 86400 first week, then 31536000
SITE_CONTACT_TO=customer@poshmedica.com
SITE_ENQUIRY_DAYS=365         # contact messages are deleted after this many days
ADMIN_REQUIRE_2FA=true        # every admin account must set up an authenticator app
